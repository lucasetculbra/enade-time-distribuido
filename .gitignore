# Apresentação (não versionada)
apresentacao/

# Dados brutos do INEP (~7 GB — acima dos limites do GitHub;
# baixáveis em gov.br/inep; o pipeline reproduz a partir de dados_processados/)
microdados_enade_*/

# Backups com timestamp gerados pelos utilitários de tools/ (recriáveis)
dados_processados/*.backup_*.csv

# Rede de segurança da migração (pg_dump, CSVs de benchmark, golden JSONs)
backups/

# Saídas dos geradores de documento/apresentação (binários regeráveis do banco)
docs/geradores/out/

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Node (o frontend/.gitignore cobre o subdiretório; reforço na raiz)
node_modules/
frontend/dist/

# Ambiente / segredos
.env
.env.local
.env.production

# Claude Code (configuração local)
.claude/

# SO / editor
.DS_Store
Thumbs.db
*.log
